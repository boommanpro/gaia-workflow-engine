{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gaia.workflow/schemas/node/branches",
  "title": "branches",
  "type": "object",
  "description": "分支节点（多组条件互斥 switch-case）。branches[].id 同时是输出字段名与出边端口名；logic 只认 and/or；子条件结构与 condition 节点一致，operator 合法值：contains/not_contains/eq/neq/gt/gte/lt/lte/is_empty/is_not_empty/is_true/is_false。出边 fromPort 必须用分支 id 或 else。 outputs 是每个分支 id 的布尔命中结果（else 分支命中时 else=true），不是业务结果——分支专属文案/数值请在各分支后接 string-format/code 生成，再汇入 end；不要把 branches 的布尔输出直接引用为业务结果。outputs 为系统派生字段（勿手写）：保存时自动从 branches 重算每个分支 id + else 的布尔声明。",
  "definitions": {
    "constantValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "constant"
          ]
        },
        "content": {},
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "refValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ref"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "templateValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "template"
          ]
        },
        "content": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "expressionValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "expression"
          ]
        },
        "content": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "timeout": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "retryTimes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "logic": {
            "type": "string",
            "enum": [
              "and",
              "or"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "constant",
                        "ref",
                        "template",
                        "expression"
                      ]
                    },
                    "content": {},
                    "operator": {
                      "type": "string",
                      "enum": [
                        "contains",
                        "not_contains",
                        "eq",
                        "neq",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "is_empty",
                        "is_not_empty",
                        "is_true",
                        "is_false"
                      ]
                    },
                    "left": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/refValue"
                        },
                        {
                          "$ref": "#/definitions/constantValue"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "right": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/refValue"
                        },
                        {
                          "$ref": "#/definitions/constantValue"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "description": "派生字段（系统自动生成，模型/用户勿手写）：每次保存从 conditions（或 branches）整体重算——每个 key/分支 id 的布尔命中结果 + 恒在的 else（布尔）。模型只需维护 conditions/branches 本身。",
      "properties": {
        "type": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "boolean"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "branches"
  ],
  "additionalProperties": false
}
