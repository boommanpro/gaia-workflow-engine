{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gaia.workflow/schemas/node/end",
  "title": "end",
  "type": "object",
  "description": "结束节点：inputsValues 用 {type:'ref',content:[上游节点id,字段名]} 引用上游输出作为工作流产物；每个键必须有意义（空 = 无产出会被拒绝）。键会自动在 inputs.properties 补声明。",
  "definitions": {
    "constantValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "constant"
          ]
        },
        "content": {},
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "refValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ref"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "templateValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "template"
          ]
        },
        "content": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "expressionValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "expression"
          ]
        },
        "content": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "timeout": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "retryTimes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "inputsValues": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/refValue"
          },
          {
            "$ref": "#/definitions/constantValue"
          },
          {
            "$ref": "#/definitions/templateValue"
          },
          {
            "$ref": "#/definitions/expressionValue"
          }
        ]
      }
    },
    "inputs": {
      "type": "object"
    }
  },
  "required": [
    "inputsValues"
  ],
  "additionalProperties": false
}
