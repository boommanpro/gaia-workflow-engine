{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gaia.workflow/schemas/node/condition",
  "title": "condition",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "object"
          }
        },
        "required": [
          "key"
        ]
      }
    }
  },
  "required": [
    "conditions"
  ],
  "additionalProperties": true
}