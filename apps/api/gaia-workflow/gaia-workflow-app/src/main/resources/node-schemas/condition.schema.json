{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gaia.workflow/schemas/node/condition",
  "title": "condition",
  "type": "object",
  "description": "条件节点（单条件 if/else）。conditions[].key 同时是输出字段名与出边端口名；operator 合法值：contains/not_contains/eq/neq/gt/gte/lt/lte/is_empty/is_not_empty/is_true/is_false（注意是 neq/gte/lte，不是 ne/ge/le）。出边 fromPort 必须用 key 或 else，不能用 true/false。outputs 是每个 key 的布尔判定结果（命中=true，否则走 else 时 else=true），不是业务结果——要产出分支专属文案/数值，请在各分支后接 string-format/code 生成，再汇入 end；不要把 condition 的布尔输出直接引用为业务结果。",
  "definitions": {
    "constantValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "constant"
          ]
        },
        "content": {},
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "refValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ref"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "templateValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "template"
          ]
        },
        "content": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "expressionValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "expression"
          ]
        },
        "content": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "extra": {}
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "timeout": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "retryTimes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "constant",
                  "ref",
                  "template",
                  "expression"
                ]
              },
              "content": {},
              "operator": {
                "type": "string",
                "enum": [
                  "contains",
                  "not_contains",
                  "eq",
                  "neq",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "is_empty",
                  "is_not_empty",
                  "is_true",
                  "is_false"
                ]
              },
              "left": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/refValue"
                  },
                  {
                    "$ref": "#/definitions/constantValue"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "right": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/refValue"
                  },
                  {
                    "$ref": "#/definitions/constantValue"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "conditions"
  ],
  "additionalProperties": false
}
