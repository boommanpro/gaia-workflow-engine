{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gaia.workflow/schemas/node/llm",
  "title": "llm",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "inputsValues": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "timeout": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "timeout": {
          "type": "integer"
        },
        "retryTimes": {
          "type": "integer"
        }
      }
    }
  },
  "required": [
    "inputsValues"
  ],
  "additionalProperties": true,
  "x-gaia-outputs": [
    "result"
  ],
  "x-gaia-form-inputs": {
    "type": "object",
    "required": ["modelName", "apiKey", "apiHost", "temperature", "prompt"],
    "properties": {
      "modelName": { "type": "string" },
      "apiKey": { "type": "string" },
      "apiHost": { "type": "string" },
      "temperature": { "type": "number" },
      "systemPrompt": { "type": "string", "extra": { "formComponent": "prompt-editor" } },
      "prompt": { "type": "string", "extra": { "formComponent": "prompt-editor" } }
    }
  }
}