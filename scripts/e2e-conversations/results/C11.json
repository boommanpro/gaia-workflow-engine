          "title": "电话清洗",
          "script": {
            "language": "javascript",
            "content": "// 清洗电话号码：过滤空值、\"待补\"、纯空格，以及非纯数字/非11位中国大陆号码\nvar phones = phones || [];\nvar validPhones = [];\nvar invalidPhones = [];\n\nfor (var i = 0; i < phones.length; i++) {\n  var p = phones[i];\n  // 空值、null、undefined\n  if (p == null || p === '') {\n    invalidPhones.push({ phone: p, reason: '空值' });\n    continue;\n  }\n  var str = String(p).trim();\n  // 空字符串（原值全是空格）\n  if (str === '') {\n    invalidPhones.push({ phone: p, reason: '纯空格' });\n    continue;\n  }\n  // 待补\n  if (str === '待补') {\n    invalidPhones.push({ phone: p, reason: '待补' });\n    continue;\n  }\n  // 中国大陆手机号：1开头，第二位3-9，共11位纯数字\n  if (/^1[3-9]\\d{9}$/.test(str)) {\n    validPhones.push(str);\n  } else {\n    invalidPhones.push({ phone: p, reason: '格式不符' });\n  }\n}\n\n({ validPhones: validPhones, invalidPhones: invalidPhones });"
          }
        },
