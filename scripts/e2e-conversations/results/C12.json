            "content": "var sales = sales || [];\nvar result = {};\n\nif (sales.length === 0) {\n    result.error = \"销售额数组为空数组\";\n    result;\n}\n\nvar total = 0;\nvar max = sales[0];\nvar min = sales[0];\n\nfor (var i = 0; i < sales.length; i++) {\n    var s = Number(sales[i]);\n    total += s;\n    if (s > max) max = s;\n    if (s < min) min = s;\n}\n\nvar average = total / sales.length;\n\nresult.totalSales = total;\nresult.averageSales = average;\nresult.maxSale = max;\nresult.minSale = min;\nresult.count = sales.length;\nresult;"
